
<% layout("/layouts/boilerplate.ejs") %>

<main class="ar-projects">

  <!-- PROJECT HERO -->
  <section class="projects-hero">

    <div class="projects-hero-top">
      <span>ARSHANA / PROJECTS</span>
      <span>ENGINEERING • INFRASTRUCTURE • EXECUTION</span>
    </div>

    <div class="projects-hero-content">

      <h1>
        Work that<br>
        moves <em>forward.</em>
      </h1>

      <p>
        Every project is an opportunity to build dependable
        infrastructure through thoughtful planning,
        technical expertise and precise execution.
      </p>

      <a href="#project-overview" class="projects-hero-link">
        EXPLORE OUR WORK <span>↘</span>
      </a>
    </div>

    <div class="projects-hero-image">
      <img
        src="/assets/image8.png"
        alt="Pipeline infrastructure project"
      >

      <div class="projects-image-overlay"></div>

      <div class="projects-image-caption">
        <span>ARSHANA / PROJECT PORTFOLIO</span>
        <strong>Built with purpose.<br>Delivered with precision.</strong>
      </div>
    </div>

    <div class="projects-hero-footer">
      <span>01 — PROJECTS</span>
      <span>SCROLL TO EXPLORE ↓</span>
    </div>

  </section>


  <!-- PROJECT OVERVIEW -->
  <section class="projects-overview" id="project-overview">

    <div class="projects-overview-left">
      <span class="projects-eyebrow">OUR WORK / 01</span>

      <h2>
        Infrastructure<br>
        with <em>intent.</em>
      </h2>
    </div>

    <div class="projects-overview-right">
      <p>
        Arshana Project Private Limited works across oil
        and gas pipeline infrastructure, city gas distribution,
        operations and maintenance, and civil construction.
      </p>

      <span>ENGINEERING CAPABILITIES / ARSHANA</span>
    </div>

  </section>


  <!-- FEATURED PROJECT -->
  <section class="projects-featured">

    <div class="projects-section-heading">
      <span class="projects-eyebrow">SELECTED WORK / 02</span>
      <h2>Featured <em>project.</em></h2>
    </div>

    <div class="projects-featured-image">
      <img
        src="/assets/image11.png"
        alt="Pipeline engineering and infrastructure"
        loading="lazy"
      >

      <span class="projects-image-index">01 / FEATURED</span>
    </div>

    <div class="projects-featured-info">
      <div>
        <span>PROJECT CATEGORY</span>
        <h3>Pipeline Infrastructure</h3>
      </div>

      <p>
        Project description and verified execution details
        will be added after confirmation from the Arshana team.
      </p>
    </div>

  </section>


  <!-- PROJECT CATEGORIES -->
  <section class="projects-categories">

    <div class="projects-section-heading">
      <span class="projects-eyebrow">AREAS OF WORK / 03</span>
      <h2>Where we <em>operate.</em></h2>
    </div>

    <div class="projects-category-grid">

      <article class="projects-category-card">
        <img
          src="/assets/image6.png"
          alt="Oil and gas pipeline infrastructure"
          loading="lazy"
        >
        <span>01 / PIPELINE</span>
        <h3>Oil & Gas Pipeline Infrastructure</h3>
      </article>

      <article class="projects-category-card">
        <img
          src="/assets/image7.png"
          alt="City gas distribution infrastructure"
          loading="lazy"
        >
        <span>02 / DISTRIBUTION</span>
        <h3>City Gas Distribution</h3>
      </article>

      <article class="projects-category-card">
        <img
          src="/assets/image10.png"
          alt="Industrial operations and maintenance"
          loading="lazy"
        >
        <span>03 / OPERATIONS</span>
        <h3>Operations & Maintenance</h3>
      </article>

      <article class="projects-category-card">
        <img
          src="/assets/image9.png"
          alt="Civil construction work"
          loading="lazy"
        >
        <span>04 / CONSTRUCTION</span>
        <h3>Civil Construction</h3>
      </article>

    </div>

  </section>


  <!-- CTA -->
  <section class="projects-cta">

    <span class="projects-eyebrow">THE NEXT PROJECT STARTS HERE</span>

    <h2>
      Let's build<br>
      something <em>lasting.</em>
    </h2>

    <a href="/contact" class="projects-cta-button">
      DISCUSS A PROJECT <span>↗</span>
    </a>

  </section>

</main>
