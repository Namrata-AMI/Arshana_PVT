
<% layout("/layouts/boilerplate.ejs") %>

<!-- ABOUT HERO -->
<section class="about-hero-v2">
    <div class="about-hero-grid" aria-hidden="true"></div>

    <div class="container about-hero-inner">

        <div class="about-hero-copy">
            <div class="story-kicker reveal">
                <span class="kicker-line"></span>
                ABOUT ARSHANA
                <span class="kicker-index">01 — 05</span>
            </div>

            <h1 class="hero-title reveal">
                Engineering<br>
                <span>what moves</span><br>
                the world.
            </h1>

            <div class="hero-bottom reveal">
                <p>
                    Pipeline engineering and infrastructure,
                    approached with precision, responsibility,
                    and purpose.
                </p>

                <a href="#company-story" class="scroll-cue">
                    <span>Discover our approach</span>
                    <span class="scroll-cue-icon" aria-hidden="true">↓</span>
                </a>
            </div>
        </div>

        <div class="about-hero-media reveal">
            <img
                src="/assets/image1.png"
                alt="Pipeline and industrial infrastructure"
                fetchpriority="high"
            >

            <div class="hero-media-overlay"></div>

            <div class="hero-media-top">
                <span>ENGINEERING & INFRASTRUCTURE</span>
                <span>AP / 01</span>
            </div>

            <div class="hero-media-bottom">
                <span class="hero-media-line"></span>
                <span>Built around what matters.</span>
            </div>
        </div>

    </div>

    <div class="hero-footer container">
        <span>THOUGHTFUL ENGINEERING. PURPOSEFUL EXECUTION.</span>
        <a href="#company-story">SCROLL TO EXPLORE ↓</a>
    </div>
</section>


<!-- COMPANY STORY -->
<section class="story-section" id="company-story">

    <div class="container">

        <div class="section-intro reveal">
            <div class="section-label">
                <span>01</span>
                <span>WHO WE ARE</span>
            </div>

            <div class="section-intro-copy">
                <h2>
                    Built for the<br>
                    <em>real world.</em>
                </h2>

                <p>
                    Infrastructure is more than steel and systems.
                    It connects industries, supports communities,
                    and keeps essential operations moving.
                </p>
            </div>
        </div>

        <div class="story-feature">

            <div class="story-feature-image reveal">
                <img
                    src="/assets/image2.png"
                    alt="Industrial pipeline engineering and infrastructure"
                    loading="lazy"
                >

                <span class="image-index">FIELD NOTES — 001</span>
            </div>

            <div class="story-feature-copy reveal">
                <span class="small-overline">OUR PERSPECTIVE</span>

                <h3>
                    Infrastructure<br>
                    that works<br>
                    <em>beyond today.</em>
                </h3>

                <p>
                    We approach pipeline and infrastructure
                    requirements with an understanding that every
                    detail contributes to the bigger picture.
                </p>

                <p>
                    From planning through execution, our focus is
                    on technical care, coordination, and work that
                    respects project requirements.
                </p>

                <div class="story-note">
                    <span class="story-note-mark">↗</span>
                    <span>Purpose in every stage of the process.</span>
                </div>
            </div>

        </div>

    </div>
</section>


<!-- OUR APPROACH -->
<section class="approach-section">

    <div class="container">

        <div class="approach-heading reveal">
            <div>
