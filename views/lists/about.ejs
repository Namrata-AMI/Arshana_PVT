        <!-- CONTACT CTA -->
        <section class="about-contact">
            <div class="about-contact-decoration" aria-hidden="true"></div>

            <div class="about-contact-content">
                <span class="about-section-index">05 / LET'S CONNECT</span>

                <h2>
                    Let's build<br>
                    <span>what's next.</span>
                </h2>

                <p>
                    Have an infrastructure project in mind?
                    Let's start a conversation.
                </p>

                <a href="/contact" class="about-contact-btn">
                    Discuss your project
                    <span>↗</span>
                </a>
            </div>

            <span class="about-contact-watermark" aria-hidden="true">
                ARSHANA
            </span>
        </section>

