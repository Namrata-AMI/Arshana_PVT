
<% layout("/layouts/boilerplate.ejs") %>

<!-- ==========================================
     ARSHANA — HERO SECTION
========================================== -->

<section class="arshana-hero" id="top">

    <!-- BACKGROUND SLIDES -->
    <div class="hero-background">
        <img src="/assets/image4.png" class="hero-bg-image active" alt="Pipeline infrastructure">
        <img src="/assets/image2.png" class="hero-bg-image" alt="Industrial engineering">
        <img src="/assets/image3.png" class="hero-bg-image" alt="Infrastructure project">
    </div>

    <!-- DARK OVERLAY -->
    <div class="hero-overlay"></div>

    <!-- HERO CONTENT -->
    <div class="hero-content container">

        <div class="hero-top-label">
            <span class="hero-label-line"></span>
            ENGINEERING · INFRASTRUCTURE · EXECUTION
        </div>

        <div class="hero-main-grid">

            <!-- LEFT SIDE -->
            <div class="hero-heading-area">

                <h1>
                    Engineering<br>
                    <span>what moves</span><br>
                    the world.
                </h1>

                <div class="hero-bottom-line">
                    <span class="hero-slide-count">01</span>
                    <span class="hero-count-divider"></span>
                    <span>THOUGHTFUL ENGINEERING. PURPOSEFUL EXECUTION.</span>
                </div>

                <a href="/about" class="hero-discover-btn">
                    Discover Arshana
                    <span class="hero-btn-arrow">↗</span>
                </a>

            </div>

            <!-- RIGHT SIDE -->
            <div class="hero-description-area">

                <span class="hero-side-label">BUILT WITH PURPOSE</span>

                <p>
                    Delivering pipeline engineering and infrastructure
                    solutions through careful planning, technical
                    understanding and a commitment to dependable
                    project execution.
                </p>

                <a href="/services" class="hero-secondary-btn">
                    Explore our services
                    <span>↗</span>
                </a>

            </div>

        </div>

        <!-- SLIDER CONTROLS -->
        <div class="hero-slider-controls">

            <button class="hero-slider-btn hero-prev" aria-label="Previous slide">
                ←
            </button>

            <div class="hero-slider-progress">
                <span class="hero-progress-fill"></span>
            </div>

            <button class="hero-slider-btn hero-next" aria-label="Next slide">
                →
            </button>

        </div>

        <!-- VERTICAL SIDE TEXT -->
        <div class="hero-vertical-text">
            ARSHANA PROJECT PRIVATE LIMITED
        </div>

    </div>

    <!-- FLOATING FEATURE CARD -->
    <div class="hero-feature-card">

        <div class="hero-feature-image">
            <img src="/assets/image2.png" class="hero-card-image" alt="Arshana engineering work">
            <span class="hero-image-tag">OUR APPROACH</span>
        </div>

        <div class="hero-feature-content">

            <span class="hero-feature-number">01 / ENGINEERING</span>

            <h3>
                Built around<br>
                <span>what matters.</span>
            </h3>

            <p>
                Bringing planning, coordination and technical
                focus together for infrastructure projects.
            </p>

            <a href="/about" aria-label="Learn more about Arshana">↗</a>

        </div>

    </div>

</section>


<!-- ==========================================
     ARSHANA — WHO WE ARE
========================================== -->

<section class="arshana-intro-section" id="about-preview">

    <div class="container">

        <!-- SECTION TOP -->
        <div class="intro-top">

            <div class="intro-top-label">
                <span class="intro-label-line"></span>
                <span>WHO WE ARE</span>
            </div>

            <div class="intro-top-heading">

                <h2>
                    A clearer approach to
