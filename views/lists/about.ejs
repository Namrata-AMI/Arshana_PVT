                </p>

                <a href="/about" class="intro-explore-btn">
                    <span>Discover Arshana</span>

                    <span class="intro-explore-icon">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </span>
                </a>

            </div>


            <!-- FLOATING CIRCULAR ELEMENT -->
            <div class="intro-round-mark">

                <span class="intro-round-number">A</span>

                <span class="intro-round-text">
                    ENGINEERING<br>
                    EXCELLENCE
                </span>

            </div>


            <!-- SMALL OVERLAPPING INFORMATION CARD -->
            <div class="intro-mini-card">

                <div class="intro-mini-card-top">
                    <span>OUR APPROACH</span>

                    <span class="intro-mini-icon">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </span>
                </div>

                <h4>
                    Precision in every
                    <span>project.</span>
                </h4>

                <p>
                    Thoughtful execution. Reliable outcomes.
                </p>

            </div>

        </div>


        <!-- BOTTOM INFORMATION -->
        <div class="intro-bottom">

            <p>
                We bring together expertise, responsibility and
                a commitment to building infrastructure that lasts.
            </p>

            <div class="intro-bottom-note">
                <span class="intro-bottom-dot"></span>
                <span>BUILT ON TRUST. DRIVEN BY PURPOSE.</span>
            </div>

        </div>

    </div>

</section>


