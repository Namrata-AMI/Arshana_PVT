
<% layout("/layouts/boilerplate.ejs") %>

<!-- HERO -->
<section class="about-page">
    <div class="container">

        <!-- HERO INTRO -->
        <section class="about-hero" id="top">
            <div class="about-hero-copy">
                <span class="about-eyebrow">ENGINEERING & INFRASTRUCTURE</span>

                <h1>
                    Engineering<br>
                    what moves<br>
                    <span>the world.</span>
                </h1>

                <p>
                    Pipeline engineering and infrastructure,
                    approached with precision, responsibility,
                    and purpose.
                </p>

                <div class="about-hero-actions">
                    <a href="#company-story" class="about-primary-btn">
                        Discover Arshana <span>↗</span>
                    </a>
                    <a href="/services" class="about-secondary-btn">
                        Explore services
                    </a>
                </div>

                <div class="about-hero-note">
                    <span class="about-note-dot"></span>
                    Thoughtful engineering. Purposeful execution.
                </div>
            </div>

            <div class="about-hero-visual">
                <div class="about-visual-label">
                    <span>ARSHANA</span>
                    <span>01 / 05</span>
                </div>

                <div class="about-main-image">
                    <img
                        src="/assets/image1.png"
                        alt="Pipeline and industrial infrastructure"
                        fetchpriority="high"
                    >
                </div>

                <div class="about-floating-card">
                    <span class="floating-icon">↗</span>
                    <div>
                        <strong>Built around what matters.</strong>
                        <small>Engineering with purpose</small>
                    </div>
                </div>

                <span class="about-visual-caption">INDUSTRIAL INFRASTRUCTURE</span>
                <span class="about-visual-circle" aria-hidden="true"></span>
            </div>
        </section>

        <!-- INTRO / COMPANY STORY -->
        <section class="about-story" id="company-story">
            <div class="about-section-heading">
                <span class="about-section-index">01 / WHO WE ARE</span>
                <h2>
                    Built for the<br>
                    <span>real world.</span>
                </h2>
            </div>

            <div class="about-story-grid">
                <div class="about-story-image">
                    <img
                        src="/assets/image2.png"
                        alt="Industrial pipeline engineering"
                        loading="lazy"
                    >
                    <span class="about-image-caption">FIELD NOTES — 001</span>
                </div>

                <div class="about-story-content">
                    <span class="about-mini-label">OUR PERSPECTIVE</span>

                    <h3>
                        Infrastructure<br>
                        that works<br>
                        <span>beyond today.</span>
                    </h3>

                    <p>
                        Infrastructure is more than steel and systems.
                        It connects industries, supports communities,
                        and keeps essential operations moving.
                    </p>

                    <p>
                        We approach pipeline and infrastructure
                        requirements with attention to technical detail,
                        coordination, and project requirements.
                    </p>

                    <a href="/services" class="about-inline-link">
                        Discover our services <span>↗</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- APPROACH -->
        <section class="about-approach">
            <div class="about-approach-heading">
                <div>
                    <span class="about-section-index">02 / OUR APPROACH</span>
                    <h2>
                        Precision in<br>
                        every <span>connection.</span>
                    </h2>
                </div>

                <p>
                    A considered approach to planning, execution,
                    and quality helps keep each stage aligned
                    with project requirements.
                </p>
            </div>

            <div class="about-approach-grid">
                <article class="about-approach-card">
                    <div class="about-card-top">
                        <span>01</span>
                        <span class="about-card-symbol">↗</span>
                    </div>
                    <div class="about-card-art art-planning">
                        <span class="art-circle"></span>
                        <span class="art-line"></span>
                        <span class="art-center">P</span>
                    </div>
                    <h3>Planning</h3>
                    <p>
                        Understand project requirements, coordinate
                        priorities, and prepare for the work ahead.
                    </p>
                    <span class="about-card-bottom">START WITH CLARITY</span>
                </article>

                <article class="about-approach-card approach-card-featured">
                    <div class="about-card-top">
                        <span>02</span>
                        <span class="about-card-symbol">↗</span>
                    </div>
                    <div class="about-card-art art-execution">
                        <span class="art-circle"></span>
                        <span class="art-line"></span>
                        <span class="art-center">E</span>
                    </div>
                    <h3>Execution</h3>
                    <p>
                        Keep technical details, communication,
                        and project coordination in focus.
                    </p>
                    <span class="about-card-bottom">MAKE EVERY STEP COUNT</span>
                </article>

                <article class="about-approach-card">
                    <div class="about-card-top">
                        <span>03</span>
                        <span class="about-card-symbol">↗</span>
                    </div>
                    <div class="about-card-art art-quality">
                        <span class="art-circle"></span>
                        <span class="art-line"></span>
                        <span class="art-center">Q</span>
                    </div>
                    <h3>Quality</h3>
                    <p>
                        Give attention to workmanship, inspection,
                        and applicable project specifications.
                    </p>
                    <span class="about-card-bottom">FINISH WITH CARE</span>
                </article>
            </div>
        </section>

        <!-- MISSION & VISION -->
        <section class="about-purpose">
            <div class="about-section-heading">
                <span class="about-section-index">03 / OUR PURPOSE</span>
                <h2>
                    What drives<br>
                    <span>the work.</span>
                </h2>
            </div>

            <div class="about-purpose-grid">
                <article class="about-purpose-card purpose-dark">
                    <div class="purpose-top">
                        <span>OUR MISSION</span>
                        <span>01 / 02</span>
                    </div>

                    <div class="purpose-icon">↗</div>

                    <h3>Deliver with purpose.</h3>

                    <p>
                        Approach each project with careful planning,
                        technical responsibility, and commitment to
                        agreed requirements and quality standards.
                    </p>

                    <span class="purpose-watermark">01</span>
                </article>

                <article class="about-purpose-card purpose-light">
                    <div class="purpose-top">
                        <span>OUR VISION</span>
                        <span>02 / 02</span>
                    </div>

                    <div class="purpose-icon">✳</div>

                    <h3>Build for the future.</h3>

                    <p>
                        Contribute to dependable infrastructure through
                        thoughtful engineering, continuous improvement,
                        and professional project execution.
                    </p>

                    <span class="purpose-watermark">02</span>
                </article>
            </div>
        </section>

        <!-- VALUES -->
        <section class="about-values">
            <div class="about-approach-heading">
                <div>
                    <span class="about-section-index">04 / OUR PRINCIPLES</span>
                    <h2>
                        Four things<br>
                        <span>that matter.</span>
                    </h2>
                </div>

                <p>
                    The principles that guide our approach to engineering,
                    collaboration, and project execution.
                </p>
            </div>

            <div class="about-values-grid">
                <article class="about-value-card">
                    <div class="about-value-top">
                        <span>01</span>
                        <span>＋</span>
                    </div>
                    <h3>Precision</h3>
                    <p>
                        Attention to detail in planning,
                        technical work, and execution.
                    </p>
                    <span class="about-value-bottom">DETAIL IS EVERYTHING</span>
                </article>

                <article class="about-value-card value-orange">
                    <div class="about-value-top">
                        <span>02</span>
                        <span>◇</span>
                    </div>
                    <h3>Safety</h3>
                    <p>
                        Responsible practices and respect for
                        applicable safety requirements.
                    </p>
                    <span class="about-value-bottom">PEOPLE FIRST</span>
                </article>

                <article class="about-value-card">
                    <div class="about-value-top">
                        <span>03</span>
                        <span>▦</span>
                    </div>
                    <h3>Quality</h3>
                    <p>
                        A consistent focus on workmanship,
                        inspection, and project specifications.
                    </p>
                    <span class="about-value-bottom">DONE WITH CARE</span>
                </article>

                <article class="about-value-card value-navy">
                    <div class="about-value-top">
                        <span>04</span>
                        <span>↗</span>
                    </div>
                    <h3>Collaboration</h3>
                    <p>
                        Clear communication and coordination
                        among project stakeholders.
                    </p>
                    <span class="about-value-bottom">BETTER TOGETHER</span>
                </article>
            </div>
