        <div class="hero-overlay"></div>

        <div class="hero-content container">

            <div class="hero-main-grid hero-stats-layout">

                <div class="hero-heading-area">

                    <h1>
                        Building India's
                        <span>Energy</span>
                        Backbone.
                    </h1>

                    <p>
                        Delivering dependable pipeline engineering and
                        infrastructure solutions through experience,
                        technical expertise and precise execution.
                    </p>

                    <a href="/about" class="hero-secondary-btn">
                        Discover Arshana <span>↗</span>
                    </a>

                </div>

                <div class="hero-stats-grid">

                    <div class="hero-stat-card">
                        <span>01 / INFRASTRUCTURE</span>
                        <h2>6500+</h2>
                        <p>KM OF PIPELINES</p>
                    </div>

                    <div class="hero-stat-card">
                        <span>02 / EXPERIENCE</span>
                        <h2>27+</h2>
                        <p>YEARS OF EXPERIENCE</p>
                    </div>

                    <div class="hero-stat-card">
                        <span>03 / REACH</span>
                        <h2>20</h2>
                        <p>STATES COVERED</p>
                    </div>

                    <div class="hero-stat-card">
                        <span>04 / EXECUTION</span>
                        <h2>4+</h2>
                        <p>PROJECTS COMPLETED</p>
                    </div>

                </div>

            </div>

            <!-- SLIDER CONTROLS -->

            <div class="hero-slider-controls">

                <button class="hero-slider-btn hero-prev"
                        type="button"
                        aria-label="Previous slide">
                    ←
                </button>

                <div class="hero-slider-progress">
                    <span class="hero-progress-fill"></span>
                </div>

                <button class="hero-slider-btn hero-next"
                        type="button"
                        aria-label="Next slide">
                    →
                </button>

            </div>

        </div>

        <!-- FLOATING FEATURE CARD -->

        <div class="hero-feature-card">

            <div class="hero-feature-image">

                <img src="/assets/image2.png"
