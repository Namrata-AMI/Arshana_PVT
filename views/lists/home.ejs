
<% layout("/layouts/boilerplate.ejs") %>

<style>
    /* =========================================
   ARSHANA — GLOBAL STYLES
========================================= */

:root {
    --primary-color: #19375b;
    --dark-color: #102743;
    --accent-color: #e8753b;
    --light-color: #f5f3ef;
    --white-color: #ffffff;
    --text-color: #202a36;
    --muted-color: #697482;
    --heading-font: 'Manrope', sans-serif;
    --body-font: 'Inter', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--body-font);
    background: var(--white-color);
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.7;
    overflow-x: hidden;
}

a {
    text-decoration: none;
}

img {
    max-width: 100%;
    display: block;
}

button,
input,
textarea,
select {
    font-family: inherit;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--heading-font);
    color: var(--dark-color);
    font-weight: 700;
    line-height: 1.2;
}

p {
    margin-bottom: 0;
}

.container {
    max-width: 1240px;
}

.section-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent-color);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.section-eyebrow span {
    width: 30px;
    height: 2px;
    background: var(--accent-color);
}

.section-padding {
    padding: 100px 0;
}

.btn-arshana {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1px solid var(--primary-color);
    border-radius: 2px;
    background: var(--primary-color);
    color: var(--white-color);
    font-size: 12px;
    font-weight: 600;
    transition: background .3s ease, border-color .3s ease;
}

.btn-arshana:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: var(--white-color);
}

.link-arshana {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--primary-color);
    font-size: 12px;
    font-weight: 700;
    transition: color .3s ease;
}

.link-arshana:hover {
    color: var(--accent-color);
}

/* =========================================
   NAVBAR
========================================= */

.arshana-navbar {
    position: relative;
    z-index: 1000;
    width: 100%;
    padding: 15px 0;
    background: #fff;
    border-bottom: 1px solid #edf0f3;
}

.arshana-navbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.arshana-navbar .navbar-collapse {
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.arshana-navbar .navbar-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.8vw, 25px);
    margin: 0 auto;
}

.arshana-navbar .nav-link {
    position: relative;
    padding: 8px 0 !important;
    color: #465364;
    font-family: var(--body-font);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: color .25s ease;
}

.arshana-navbar .nav-link::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .25s ease;
}

.arshana-navbar .nav-link:hover,
.arshana-navbar .nav-link:focus-visible,
.arshana-navbar .nav-link.active {
    color: var(--primary-color);
}

.arshana-navbar .nav-link:hover::after,
.arshana-navbar .nav-link:focus-visible::after,
.arshana-navbar .nav-link.active::after {
    transform: scaleX(1);
}

.arshana-navbar .arshana-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 11px 16px;
    border: 1px solid var(--primary-color);
    border-radius: 2px;
    background: var(--primary-color);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    transition: background .25s ease, border-color .25s ease;
}

.arshana-navbar .arshana-nav-btn:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #fff;
}

.arshana-navbar .arshana-nav-btn i {
    font-size: 10px;
}

.arshana-navbar .navbar-toggler {
    padding: 7px 9px;
    border: 1px solid #e3e7eb;
    border-radius: 2px;
    box-shadow: none;
}

.arshana-navbar .navbar-toggler:focus {
    box-shadow: 0 0 0 3px rgba(25, 55, 91, .1);
}

/* =========================================
   ABOUT HERO
========================================= */

.about-hero-v2 {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 540px;
    overflow: hidden;
    isolation: isolate;
    background: var(--dark-color);
    color: #fff;
}

.about-hero-v2 > img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.about-hero-v2::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
        90deg,
        rgba(16, 39, 67, .88),
        rgba(16, 39, 67, .42)
    );
}

.about-hero-grid {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 32px;
}

.about-hero-inner {
    max-width: 680px;
}

.about-hero-v2 h1 {
    max-width: 650px;
    margin: 20px 0;
    color: #fff;
    font-size: clamp(36px, 4.5vw, 58px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -1.8px;
}

.about-hero-v2 p {
    max-width: 520px;
    color: rgba(255, 255, 255, .78);
    font-size: 14px;
    line-height: 1.8;
}

.story-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent-color);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
}

.kicker-line {
    width: 26px;
    height: 1px;
    background: currentColor;
}

.hero-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 36px;
}

.scroll-cue,
.hero-index {
    color: rgba(255, 255, 255, .7);
    font-size: 10px;
    letter-spacing: 1px;
}

/* =========================================
   COMPANY STORY — DESKTOP HORIZONTAL LAYOUT
========================================= */

.story-scroll {
    position: relative;
    background: var(--light-color);
    color: var(--dark-color);
}

.story-scroll .story-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 540px;
    overflow: hidden;
}

.story-scroll .story-track {
    display: flex;
    width: 300%;
    height: 100%;
    will-change: transform;
}

.story-scroll .story-panel {
    position: relative;
    flex: 0 0 33.333333%;
    width: 33.333333%;
    min-width: 0;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(30px, 5vw, 72px);
    padding: 55px clamp(30px, 7vw, 100px);
    overflow: hidden;
}

.story-scroll .story-intro {
    background: #f6f5f1;
}

.story-scroll .story-detail {
    background: #fff;
}

.story-scroll .story-finish {
    background: #eceae4;
}

.story-scroll .story-panel-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 500px;
    min-width: 0;
}

.story-scroll .story-count {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent-color);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
}

.story-scroll .story-count::before {
    content: "";
    width: 24px;
    height: 1px;
    background: currentColor;
}

.story-scroll .story-panel h2 {
    margin: 24px 0 20px;
    color: var(--dark-color);
    font-family: var(--heading-font);
    font-size: clamp(34px, 3.8vw, 52px);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -1.5px;
}

.story-scroll .story-panel h2 em {
    color: var(--accent-color);
    font-weight: 400;
    font-style: normal;
}

.story-scroll .story-panel p {
    max-width: 410px;
    color: var(--muted-color);
    font-size: 13px;
    line-height: 1.9;
}

.story-scroll .story-hint {
    display: inline-block;
    margin-top: 30px;
    color: var(--dark-color);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* First panel visual */

.story-scroll .story-visual {
    position: relative;
    width: 100%;
    min-width: 0;
    height: min(58vh, 420px);
    min-height: 260px;
    overflow: hidden;
    background: #deddd5;
}

.story-scroll .story-visual-one {
    background:
        linear-gradient(
            180deg,
            rgba(16, 39, 67, .02) 20%,
            rgba(16, 39, 67, .48) 100%
        ),
        url("/images/about-industrial.jpg") center / cover no-repeat,
        #deddd5;
}

.story-scroll .visual-stamp {
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 11px 13px;
    border: 1px solid rgba(255, 255, 255, .45);
    color: #fff;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.6px;
    line-height: 1.8;
}

/* Second panel specifications */

.story-scroll .story-spec {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    width: 100%;
    max-width: 370px;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(16, 39, 67, .14);
}

.story-scroll .story-spec > span {
    padding-top: 17px;
    margin-bottom: 10px;
    color: var(--accent-color);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.6px;
}

.story-scroll .story-spec > div {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 12px 0;
    border-bottom: 1px solid rgba(16, 39, 67, .12);
    color: var(--muted-color);
    font-size: 11px;
}

.story-scroll .story-spec > div b {
    color: var(--dark-color);
    font-size: 13px;
    font-weight: 500;
}

.story-scroll .story-spec small {
    margin-top: 12px;
    color: var(--muted-color);
    font-size: 11px;
}

/* Third panel */

.story-scroll .story-big-number {
    align-self: center;
    justify-self: center;
    color: rgba(23, 45, 70, .07);
    font-family: var(--heading-font);
    font-size: clamp(180px, 23vw, 300px);
    font-weight: 700;
    line-height: .85;
    letter-spacing: -.09em;
    user-select: none;
}

.story-scroll .story-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--accent-color);
    color: var(--dark-color);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: color .25s ease;
}

.story-scroll .story-link:hover {
    color: var(--accent-color);
}

/* Story progress */

.story-scroll .story-progress {
    position: absolute;
    z-index: 5;
    right: 7%;
    bottom: 22px;
    left: 7%;
    height: 2px;
    overflow: hidden;
    background: rgba(23, 45, 70, .12);
}

.story-scroll .story-progress span {
    display: block;
    width: 33.333%;
    height: 100%;
    background: var(--accent-color);
    transform-origin: left;
}

/* =========================================
   MISSION & VISION
========================================= */

.purpose-v2 {
    padding: 76px 0;
    background: #fff;
}

.purpose-row-dark,
.purpose-row-light {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    align-items: start;
    gap: 48px;
    padding: 38px;
}

.purpose-row-dark {
    background: var(--dark-color);
}

.purpose-row-light {
    background: var(--light-color);
}

.purpose-row-dark h2,
.purpose-row-dark h3 {
    color: #fff;
}

.purpose-row-light h2,
.purpose-row-light h3 {
    color: var(--dark-color);
}

.purpose-v2 h2,
.purpose-v2 h3 {
    margin: 0;
    font-size: clamp(26px, 2.7vw, 34px);
    font-weight: 600;
    letter-spacing: -.7px;
}

.purpose-v2 p {
    max-width: 580px;
    color: var(--muted-color);
    font-size: 13px;
    line-height: 1.85;
}

.purpose-row-dark p {
    color: rgba(255, 255, 255, .75);
}

/* =========================================
   CORE VALUES — ANIMATED CARDS
========================================= */

.values-v2 {
    padding: 80px 0;
    background: var(--light-color);
}

.values-v2 h2 {
    max-width: 600px;
    margin: 18px 0 12px;
    font-size: clamp(32px, 3.6vw, 46px);
    font-weight: 600;
    letter-spacing: -1px;
}

.values-v2 > .container > p {
    max-width: 540px;
    color: var(--muted-color);
    font-size: 13px;
}

.values-horizontal {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 36px;
}

.value-v2 {
    position: relative;
    min-width: 0;
    min-height: 190px;
    padding: 24px 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(16, 39, 67, .07);
    border-top: 2px solid transparent;
    box-shadow: 0 2px 8px rgba(16, 39, 67, .025);
    transform: translateY(0);
    transition:
        transform .35s ease,
        box-shadow .35s ease,
        border-color .35s ease;
}

.value-v2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent-color);
    transition: width .35s ease;
}

.value-v2:hover {
    transform: translateY(-7px);
    border-color: rgba(25, 55, 91, .12);
    box-shadow:
        0 14px 30px rgba(16, 39, 67, .09),
        0 4px 10px rgba(16, 39, 67, .04);
}

.value-v2:hover::before {
    width: 100%;
}

.value-v2-orange {
    border-top-color: var(--accent-color);
}

.value-v2-navy {
    border-top-color: var(--primary-color);
}

.value-v2-number {
    display: block;
    color: var(--accent-color);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.value-v2-symbol {
    display: inline-block;
    margin-top: 12px;
    color: var(--primary-color);
    font-size: 22px;
    line-height: 1;
    transition: transform .3s ease, color .3s ease;
}

.value-v2:hover .value-v2-symbol {
    transform: translateY(-3px);
    color: var(--accent-color);
}

.value-v2 h3 {
    margin: 18px 0 10px;
    font-size: 17px;
    font-weight: 600;
}

.value-v2 p {
    color: var(--muted-color);
    font-size: 12px;
    line-height: 1.8;
}

.value-v2-footer {
    display: block;
    margin-top: 22px;
    color: var(--muted-color);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

/* =========================================
   CLOSING CTA
========================================= */

.about-cta-v2 {
    padding: 76px 0;
    background: var(--dark-color);
}

.about-cta-v2 .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
}

.about-cta-v2 h2 {
    max-width: 620px;
    margin: 18px 0 12px;
    color: #fff;
    font-size: clamp(32px, 3.6vw, 46px);
    font-weight: 600;
    letter-spacing: -1px;
}

.about-cta-v2 p {
    max-width: 500px;
    color: rgba(255, 255, 255, .72);
    font-size: 13px;
}

.cta-v2-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 20px;
    border: 1px solid var(--accent-color);
    color: #fff;
    font-size: 12px;
    transition: background .3s ease;
}

.cta-v2-link:hover {
    background: var(--accent-color);
    color: #fff;
}

/* =========================================
   TABLET
========================================= */

@media (max-width: 991px) {
    .container {
        padding-left: 24px;
        padding-right: 24px;
    }

    .section-padding {
        padding: 75px 0;
    }

    /* Bootstrap navbar collapse */
    .arshana-navbar {
        padding: 12px 0;
    }

    .arshana-navbar .container {
        flex-wrap: wrap;
        gap: 12px;
    }

    .arshana-navbar .navbar-toggler {
        margin-left: auto;
    }

    .arshana-navbar .navbar-collapse {
        flex-basis: 100%;
        flex-grow: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
        padding-top: 18px;
    }

    .arshana-navbar .navbar-collapse:not(.show):not(.collapsing) {
        display: none;
    }

    .arshana-navbar .navbar-collapse.show,
    .arshana-navbar .navbar-collapse.collapsing {
        display: flex;
    }

    .arshana-navbar .navbar-nav {
        align-items: stretch;
        gap: 0;
        width: 100%;
        margin: 0 !important;
    }

    .arshana-navbar .nav-link {
        display: block;
        padding: 11px 0 !important;
        border-bottom: 1px solid #f0f2f4;
        font-size: 13px;
    }

    .arshana-navbar .nav-link::after {
        display: none;
    }

    .arshana-navbar .arshana-nav-btn {
        align-self: flex-start;
    }

    /* Stack story panels on tablet */
    .story-scroll .story-sticky {
        position: relative;
        height: auto;
        min-height: 0;
        overflow: visible;
    }

    .story-scroll .story-track {
        display: block;
        width: 100%;
        height: auto;
        transform: none !important;
    }

    .story-scroll .story-panel {
        width: 100%;
        height: auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, .85fr);
        gap: 28px;
        padding: 48px 28px;
    }

    .story-scroll .story-panel h2 {
        font-size: clamp(32px, 4vw, 42px);
        letter-spacing: -1px;
    }

    .story-scroll .story-visual {
        height: 300px;
        min-height: 0;
    }

    .story-scroll .story-progress {
        display: none;
    }

    .story-scroll .story-big-number {
        font-size: clamp(140px, 22vw, 220px);
    }

    .values-horizontal {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {
    body {
        font-size: 13px;
    }

    .section-padding {
        padding: 60px 0;
    }

    .section-eyebrow {
        font-size: 10px;
        letter-spacing: 1.5px;
    }

    .about-hero-v2 {
        min-height: 520px;
    }

    .about-hero-grid {
        padding: 56px 22px;
    }

    .about-hero-v2 h1 {
        font-size: 36px;
        letter-spacing: -1px;
    }

    .about-hero-v2 p {
        font-size: 13px;
    }

    .hero-bottom {
        margin-top: 28px;
    }

    .story-scroll .story-panel {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 26px;
        padding: 48px 22px;
    }

    .story-scroll .story-panel-content {
        max-width: none;
    }

    .story-scroll .story-panel h2 {
        margin: 20px 0 16px;
        font-size: 32px;
        letter-spacing: -1px;
    }

    .story-scroll .story-panel p {
        font-size: 13px;
        line-height: 1.85;
    }

    .story-scroll .story-visual {
        width: 100%;
        height: 250px;
        min-height: 0;
    }

    .story-scroll .story-hint,
    .story-scroll .story-link {
        margin-top: 24px;
    }

    .story-scroll .story-spec {
        max-width: none;
    }

    .story-scroll .story-big-number {
        align-self: flex-end;
        font-size: 150px;
    }

    .purpose-v2,
    .values-v2,
    .about-cta-v2 {
        padding: 56px 0;
    }

    .purpose-row-dark,
    .purpose-row-light {
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 26px 22px;
    }

    .purpose-v2 h2,
    .purpose-v2 h3 {
        font-size: 28px;
    }

    .values-v2 h2,
    .about-cta-v2 h2 {
        font-size: 32px;
    }

    .values-horizontal {
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 28px;
    }

    .value-v2 {
        min-height: 0;
        padding: 22px;
    }

    .about-cta-v2 .container {
        align-items: flex-start;
        flex-direction: column;
        gap: 24px;
    }
}

/* =========================================
   ACCESSIBILITY
========================================= */

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    .arshana-navbar *,
    .story-scroll *,
    .value-v2,
    .value-v2::before,
    .value-v2-symbol,
    .cta-v2-link,
    .about-hero-v2 * {
        animation: none !important;
        transition: none !important;
    }

