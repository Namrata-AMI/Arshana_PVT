
<% layout("/layouts/boilerplate.ejs") %>

<main class="arshana-home">

    <!-- ==========================================
         01 — HERO SECTION
    =========================================== -->

    <section class="arshana-hero" id="top">

        <div class="hero-background">
            <img src="/assets/image4.png"
