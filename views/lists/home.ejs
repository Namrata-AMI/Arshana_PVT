                     alt="Industrial engineering and infrastructure">

                <span class="hero-image-tag">OUR APPROACH</span>

            </div>

            <div class="hero-feature-content">

                <span class="hero-feature-number">
                    01 / ENGINEERING
                </span>

                <h3>
                    Connecting energy.
                    <br>
                    <span>Building progress.</span>
                </h3>

                <p>
                    Engineering solutions that bring infrastructure,
                    technical precision and execution together.
                </p>

                <a href="/about"
                   aria-label="Learn more about Arshana">
                    ↗
                </a>

            </div>

        </div>

